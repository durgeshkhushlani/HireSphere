PORT=3001
DATABASE_URL=postgresql://hiresphere_user:hiresphere_pass@localhost:5433/hiresphere_dev
JWT_SECRET=changeme

# Base URL of the frontend — used to build links in outgoing emails (e.g.
# the company-portal access link).
FRONTEND_URL=http://127.0.0.1:3000

# Gmail SMTP for sending OTP codes (and, later, resume delivery). Requires a
# Gmail App Password (needs 2FA enabled): https://myaccount.google.com/apppasswords
SMTP_USER=
SMTP_PASS=
# Optional — defaults to SMTP_USER if unset.
SMTP_FROM=

# Groq API key for the help chatbot (POST /api/chat). Get one at
# https://console.groq.com/keys
GROQ_API_KEY=
# Optional — defaults to a small, fast Llama model.
GROQ_MODEL=llama-3.1-8b-instant

# Cloudinary — stores student resumes (signed direct upload from the
# browser, see lib/cloudinary.js). Free account at https://cloudinary.com,
# all three values come from the dashboard's "API Environment variable" box.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
