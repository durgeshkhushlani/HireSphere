PORT=3001
DATABASE_URL=postgresql://hiresphere_user:hiresphere_pass@localhost:5433/hiresphere_dev
JWT_SECRET=changeme

# Base URL of the frontend — used to build links in outgoing emails (e.g.
# the company-portal access link).
FRONTEND_URL=http://127.0.0.1:3000

# Brevo transactional email API (https://brevo.com, free tier, no card) —
# sends OTP codes, resume delivery, notifications, etc. Used over HTTPS
# rather than SMTP because most free-tier hosts (e.g. Render) block outbound
# SMTP ports entirely. Get an API key from Brevo's dashboard under
# Settings → SMTP & API → API Keys.
BREVO_API_KEY=
# The "from" address on outgoing emails — must be a sender you've verified
# in Brevo (or, without a verified domain, Brevo's free tier only delivers
# to your own account email regardless of what's set here).
BREVO_FROM_EMAIL=

# Groq API key for the help chatbot (POST /api/chat). Get one at
# https://console.groq.com/keys
GROQ_API_KEY=
# Optional — defaults to a small, fast Llama model.
GROQ_MODEL=llama-3.1-8b-instant

# Cloudinary — stores student resumes (signed direct upload from the
# browser, see lib/cloudinary.js). Free account at https://cloudinary.com,
# all three values come from the dashboard's "API Environment variable" box.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
