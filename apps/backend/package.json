{
  "name": "@hiresphere/backend",
  "version": "0.1.0",
  "description": "HireSphere — campus placement management platform (v2 backend)",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon --exec tsx src/server.js",
    "start": "tsx src/server.js",
    "postinstall": "prisma generate",
    "test": "node --import tsx --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:watch": "node --import tsx --test --test-concurrency=1 --watch \"tests/**/*.test.js\"",
    "test:migrate": "prisma migrate deploy"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1"
  }
}
