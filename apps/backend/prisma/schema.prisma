generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STUDENT

  @@map("role")
}

enum DriveStatus {
  DRAFT
  OPEN
  CLOSED

  @@map("drive_status")
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  OA_TEST
  INTERVIEW
  SELECTED
  NOT_SELECTED

  @@map("application_status")
}

enum OfferType {
  INTERNSHIP
  JOB

  @@map("offer_type")
}

enum StudentFieldType {
  TEXT
  NUMBER
  DROPDOWN
  DATE

  @@map("student_field_type")
}

enum NotificationEvent {
  NEW_COMPANY
  NEW_DRIVE
  STUDENT_SELECTED

  @@map("notification_event")
}

model University {
  id           String  @id @default(uuid())
  name         String
  domain       String  @unique
  verified     Boolean @default(false)
  contactName  String? @map("contact_name")
  contactEmail String? @map("contact_email")
  contactPhone String? @map("contact_phone")
  // IANA zone id (e.g. "Asia/Kolkata") — governs how interview slot times
  // are interpreted/displayed everywhere in the app, not each viewer's own
  // browser timezone, since an interview happens at the university's
  // physical location regardless of who's looking at the schedule.
  timezone     String  @default("Asia/Kolkata")

  // "Try it out" demo mode: an isolated, throwaway tenant reusing the same
  // university_id scoping every other query already uses — no separate
  // isDemo/expiresAt columns needed anywhere else. demoExpiresAt is null for
  // every real university; demo.service.js sweeps rows where it's in the
  // past before minting a new demo session.
  isDemo        Boolean   @default(false) @map("is_demo")
  demoExpiresAt DateTime? @map("demo_expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users                          User[]
  universityPrograms              UniversityProgram[]
  drives                          Drive[]
  placements                      Placement[]
  studentCustomFieldDefinitions   StudentCustomFieldDefinition[]
  notificationRecipients          NotificationRecipient[]

  @@map("universities")
}

// Per-university, per-event distribution lists — an admin decides who gets
// emailed (one address or several) when a new company is added, a new drive
// opens, or a student gets selected. Nothing here gates access; it's purely
// a notification target list.
model NotificationRecipient {
  id           String            @id @default(uuid())
  universityId String            @map("university_id")
  event        NotificationEvent
  email        String

  university University @relation(fields: [universityId], references: [id])

  @@unique([universityId, event, email])
  @@map("notification_recipients")
}

model Program {
  id   String @id @default(uuid())
  name String @unique

  universityPrograms UniversityProgram[]
  studentProfiles    StudentProfile[]

  @@map("programs")
}

model UniversityProgram {
  id           String @id @default(uuid())
  universityId String @map("university_id")
  programId    String @map("program_id")

  university University @relation(fields: [universityId], references: [id])
  program    Program    @relation(fields: [programId], references: [id])

  driveEligiblePrograms DriveEligibleProgram[]

  @@unique([universityId, programId])
  @@map("university_programs")
}

model User {
  id           String @id @default(uuid())
  universityId String @map("university_id")
  role         Role
  email        String @unique
  passwordHash String @map("password_hash")
  name         String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  university     University      @relation(fields: [universityId], references: [id])
  studentProfile StudentProfile?
  placements     Placement[]

  @@map("users")
}

model StudentProfile {
  userId          String  @id @map("user_id")
  programId       String  @map("program_id")
  cgpa            Decimal @db.Decimal(4, 2)
  backlogCount    Int     @default(0) @map("backlog_count")
  placementLocked Boolean @default(false) @map("placement_locked")

  // Profile fields the student fills in themselves, editable freely until an
  // admin verifies the profile — once verified, only address/phone stay
  // editable (enforced in students.service.js, same "null = not set, checked
  // where written" convention as the rest of this schema).
  studentId         String?  @map("student_id")
  tenthPercentage   Decimal? @map("tenth_percentage") @db.Decimal(5, 2)
  twelfthPercentage Decimal? @map("twelfth_percentage") @db.Decimal(5, 2)
  bloodGroup        String?  @map("blood_group")
  address           String?
  phone             String?
  verified          Boolean  @default(false)

  // A Cloudinary-hosted PDF, uploaded via a signed direct upload (see
  // cloudinary.js) — always editable regardless of verified status, unlike
  // the fixed fields above, since a resume legitimately changes over time.
  // Required before applying to any drive (enforced in
  // applications.service.js, not here — nullable so existing profiles don't
  // break), never required for verification itself.
  resumeUrl String? @map("resume_url")

  user              User                       @relation(fields: [userId], references: [id])
  program           Program                    @relation(fields: [programId], references: [id])
  applications      Application[]
  customFieldValues StudentCustomFieldValue[]

  @@map("student_profiles")
}

// Admin-defined extra profile fields, scoped per university — lets an admin
// collect anything beyond the fixed fields above without a schema change.
model StudentCustomFieldDefinition {
  id           String           @id @default(uuid())
  universityId String           @map("university_id")
  label        String
  fieldType    StudentFieldType @map("field_type")
  required     Boolean          @default(false)
  // Only meaningful (and required) for DROPDOWN — array of option strings.
  options      Json?

  createdAt DateTime @default(now()) @map("created_at")

  university University                 @relation(fields: [universityId], references: [id])
  values     StudentCustomFieldValue[]

  @@map("student_custom_field_definitions")
}

model StudentCustomFieldValue {
  id                String  @id @default(uuid())
  studentProfileId  String  @map("student_profile_id")
  fieldDefinitionId String  @map("field_definition_id")
  value             String?

  studentProfile  StudentProfile               @relation(fields: [studentProfileId], references: [userId])
  fieldDefinition StudentCustomFieldDefinition @relation(fields: [fieldDefinitionId], references: [id])

  @@unique([studentProfileId, fieldDefinitionId])
  @@map("student_custom_field_values")
}

model Company {
  id           String  @id @default(uuid())
  name         String
  industry     String?
  contactEmail String? @map("contact_email")
  contactPhone String? @map("contact_phone")

  createdAt DateTime @default(now()) @map("created_at")

  drives     Drive[]
  placements Placement[]

  @@map("companies")
}

model Drive {
  id           String      @id @default(uuid())
  universityId String      @map("university_id")
  companyId    String      @map("company_id")
  title        String
  description  String?
  status       DriveStatus @default(DRAFT)

  // Eligibility criteria — null means "no restriction on this dimension".
  minCgpa     Decimal? @map("min_cgpa") @db.Decimal(4, 2)
  maxBacklogs Int?     @map("max_backlogs")

  // Declaring results is a deliberate, separate admin action from closing
  // the drive — an admin can close applications and still choose to hold
  // off telling the wider student body who got selected. Once declared,
  // every student at the university (not just applicants) can see the
  // selected-student list for this drive.
  resultsDeclared   Boolean   @default(false) @map("results_declared")
  resultsDeclaredAt DateTime? @map("results_declared_at")

  // Stamped each time an admin manually moves the drive to OPEN — shown to
  // students as the drive's "start" date. There's no scheduled auto-open,
  // only auto-close (below).
  openedAt DateTime? @map("opened_at")

  // Opt-in — null means "no scheduled close, admin closes it manually".
  // When set, autoCloseDispatcher.js's poller flips the drive to CLOSED
  // once this passes, the same background-job pattern as resumeDispatcher.js.
  autoCloseAt DateTime? @map("auto_close_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  university       University             @relation(fields: [universityId], references: [id])
  company          Company                @relation(fields: [companyId], references: [id])
  eligiblePrograms DriveEligibleProgram[]
  applicationForm  ApplicationForm?
  applications     Application[]
  placements       Placement[]
  roles            DriveRole[]
  companyAccess    DriveCompanyAccess?

  @@map("drives")
}

// One hiring round (Drive) gets its own portal login for the company side —
// not one login per company, since the same company may run separate drives
// across different years/universities, each with its own applicant set.
// accessCode is globally unique and doubles as the URL segment
// (hiresphere.app/<university-domain>/<accessCode>); passwordHash is never
// recoverable — see company-portal.service.js's regenerate flow.
model DriveCompanyAccess {
  id           String   @id @default(uuid())
  driveId      String   @unique @map("drive_id")
  accessCode   String   @unique @map("access_code")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  drive Drive @relation(fields: [driveId], references: [id])

  @@map("drive_company_access")
}

// A drive can cover multiple openings (e.g. "SWE" and "Data Analyst" in the
// same TechNova hiring round) — Drive.title is the campaign name, each role
// here has its own title/JD/pay. ctcAmount/stipendAmount are both nullable at
// the DB level; the "JOB needs ctcAmount, INTERNSHIP needs stipendAmount"
// rule is enforced in the service layer, same as minCgpa/maxBacklogs.
model DriveRole {
  id            String    @id @default(uuid())
  driveId       String    @map("drive_id")
  title         String
  offerType     OfferType @map("offer_type")
  description   String
  ctcAmount     Decimal?  @map("ctc_amount") @db.Decimal(10, 2)
  stipendAmount Decimal?  @map("stipend_amount") @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  drive                   Drive                       @relation(fields: [driveId], references: [id])
  rolePreferences         ApplicationRolePreference[]
  selectedForApplications Application[]               @relation("SelectedRole")
  placements              Placement[]

  @@map("drive_roles")
}

// A student's ranked role preferences for one application — 1 to however
// many roles the drive has, most-preferred first (rank 1).
model ApplicationRolePreference {
  id            String @id @default(uuid())
  applicationId String @map("application_id")
  driveRoleId   String @map("drive_role_id")
  rank          Int

  application Application @relation(fields: [applicationId], references: [id])
  driveRole   DriveRole   @relation(fields: [driveRoleId], references: [id])

  @@unique([applicationId, driveRoleId])
  @@unique([applicationId, rank])
  @@map("application_role_preferences")
}

model DriveEligibleProgram {
  id                  String @id @default(uuid())
  driveId             String @map("drive_id")
  universityProgramId String @map("university_program_id")

  drive             Drive             @relation(fields: [driveId], references: [id])
  universityProgram UniversityProgram @relation(fields: [universityProgramId], references: [id])

  @@unique([driveId, universityProgramId])
  @@map("drive_eligible_programs")
}

model ApplicationForm {
  id        String @id @default(uuid())
  driveId   String @unique @map("drive_id")
  questions Json

  createdAt DateTime @default(now()) @map("created_at")

  drive Drive @relation(fields: [driveId], references: [id])

  @@map("application_forms")
}

model Application {
  id               String            @id @default(uuid())
  driveId          String            @map("drive_id")
  studentProfileId String            @map("student_profile_id")
  responses        Json
  resumeUrl        String?           @map("resume_url")
  interviewSlot    DateTime?         @map("interview_slot")
  interviewVenue   String?           @map("interview_venue")
  status           ApplicationStatus @default(APPLIED)

  // Which of the student's preferred roles they're actually being placed
  // into — set alongside the Placement record when status moves to SELECTED.
  selectedRoleId String? @map("selected_role_id")

  // Resume delivery (plan §4): admin schedules a send time; the poller in
  // server.js dispatches it once resumeDispatchAt has passed. resumeSentAt
  // being non-null is the guard against a duplicate send.
  resumeDispatchAt DateTime? @map("resume_dispatch_at")
  resumeSentAt     DateTime? @map("resume_sent_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  drive           Drive                       @relation(fields: [driveId], references: [id])
  studentProfile  StudentProfile              @relation(fields: [studentProfileId], references: [userId])
  selectedRole    DriveRole?                  @relation("SelectedRole", fields: [selectedRoleId], references: [id])
  rolePreferences ApplicationRolePreference[]

  @@unique([driveId, studentProfileId])
  @@map("applications")
}

model EmailOtp {
  id         String    @id @default(uuid())
  email      String    @unique
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("email_otps")
}

model Placement {
  id            String   @id @default(uuid())
  universityId  String   @map("university_id")
  userId        String   @map("user_id")
  companyId     String   @map("company_id")
  driveId       String?  @map("drive_id")
  driveRoleId   String?  @map("drive_role_id")
  packageAmount Decimal? @map("package_amount") @db.Decimal(10, 2)

  placedAt DateTime @default(now()) @map("placed_at")

  university University @relation(fields: [universityId], references: [id])
  user       User       @relation(fields: [userId], references: [id])
  company    Company    @relation(fields: [companyId], references: [id])
  drive      Drive?     @relation(fields: [driveId], references: [id])
  driveRole  DriveRole? @relation(fields: [driveRoleId], references: [id])

  @@map("placements")
}
